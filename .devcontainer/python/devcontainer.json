{
  "name": "Python + Conda",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8888],
  "postCreateCommand": "bash .devcontainer/python/post-create.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/python/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
